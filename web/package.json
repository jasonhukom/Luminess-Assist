{
  "name": "luminess-assist-web",
  "private": true,
  "version": "1.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "python manage.py runserver 0.0.0.0:3000",
